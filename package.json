{
  "name": "tutoriais-interativos-microsservicos",
  "displayName": "Tutoriais Interativos de Microsserviços",
  "description": "Detecta, valida e lista tutoriais interativos definidos em index.json (US01 / UC01).",
  "version": "0.1.0",
  "publisher": "lucas-gitirana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas-gitirana/tutoriais-interativos-microsservicos.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/index.json",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tutoriais",
          "title": "Tutoriais Interativos",
          "icon": "media/tutoriais.svg"
        }
      ]
    },
    "views": {
      "tutoriais": [
        {
          "id": "tutoriaisView",
          "name": "Tutorial",
          "contextualTitle": "Tutoriais Interativos"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tutoriaisView",
        "contents": "Nenhum tutorial encontrado no workspace.\n\nAbra um repositório que contenha um arquivo `index.json` na raiz para começar.\n\n[Revalidar](command:tutoriais.revalidar)"
      }
    ],
    "commands": [
      {
        "command": "tutoriais.executar",
        "title": "Executar tutorial",
        "category": "Tutoriais Interativos",
        "icon": "$(play)"
      },
      {
        "command": "tutoriais.revalidar",
        "title": "Revalidar tutorial",
        "category": "Tutoriais Interativos",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tutoriais.revalidar",
          "when": "view == tutoriaisView",
          "group": "navigation@2"
        },
        {
          "command": "tutoriais.executar",
          "when": "view == tutoriaisView && tutoriais.disponivel",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "tutoriais.executar",
          "when": "view == tutoriaisView && viewItem == tutorialRoot && tutoriais.disponivel",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "tutoriais.executar",
          "when": "tutoriais.disponivel"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "index.json",
        "url": "./schema/tutorial.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p ./",
    "watch-tests": "tsc -p ./ -w",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile-tests && npm run build && npm run lint",
    "test": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:coverage": "npm run compile-tests && c8 --reporter=text --reporter=lcov --src out/loading --src out/fs mocha \"out/test/unit/**/*.test.js\"",
    "pretest:integration": "npm run compile-tests && npm run build",
    "test:integration": "node ./out/test/runTest.js",
    "test:all": "npm run test && npm run test:integration",
    "package": "vsce package"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.3.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.29.0",
    "c8": "^10.1.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "glob": "^10.4.1",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5"
  }
}
